{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C++ App",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.exe", // 可根据实际生成的exe路径调整
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [],
            "externalConsole": true, // 使用外部控制台显示输入输出
            "MIMode": "gdb",
            "miDebuggerPath": "F:/mingw64/bin/gdb.exe",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "启用 pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "logging": {
                "moduleLoad": true,
                "trace": true,
                "engineLogging": true
            },
        }
    ]
}